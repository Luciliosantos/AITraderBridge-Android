<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlayRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/overlay_bg"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/overlayDirection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="—"
            android:textColor="@color/warn"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/overlayConfidence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="@color/text"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/overlayMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="aguardando candles"
        android:textColor="@color/muted"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/overlayReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="3"
        android:text=""
        android:textColor="@color/text"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/overlayM15"
            style="@style/TinyButton"
            android:text="M15" />

        <Button
            android:id="@+id/overlayM5"
            style="@style/TinyButton"
            android:text="M5" />

        <Button
            android:id="@+id/overlayM1"
            style="@style/TinyButton"
            android:text="M1" />

        <Button
            android:id="@+id/overlayClose"
            style="@style/TinyButton"
            android:text="✕" />
    </LinearLayout>
</LinearLayout>