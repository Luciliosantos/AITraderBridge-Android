<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="8dp">
            <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_ai_trader_logo" android:contentDescription="AI Trader Bridge" android:layout_marginEnd="12dp" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI TRADER BRIDGE" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="IQ OPTION · LIVE TRADING" android:textColor="@color/brand" android:textSize="10sp" android:letterSpacing="0.14" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Conexão direta pela API LS Broker. Análise por candles recebidos da IQ Option." android:textColor="@color/muted" android:textSize="13sp" android:layout_marginBottom="14dp" />

        <TextView style="@style/Label" android:text="ACESSO AO LS BROKER" />
        <EditText android:id="@+id/brokerEmail" style="@style/Field" android:hint="E-mail do painel LS Broker" android:inputType="textEmailAddress" />
        <EditText android:id="@+id/brokerPassword" style="@style/Field" android:hint="Senha do painel LS Broker" android:inputType="textPassword" />
        <Button android:id="@+id/buttonLogin" style="@style/GhostButton" android:text="Entrar no painel" />
        <TextView android:id="@+id/brokerStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Não conectado ao LS Broker" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="4dp" />

        <TextView style="@style/Label" android:text="CONECTAR IQ OPTION" />
        <EditText android:id="@+id/iqEmail" style="@style/Field" android:hint="E-mail da IQ Option" android:inputType="textEmailAddress" />
        <EditText android:id="@+id/iqPassword" style="@style/Field" android:hint="Senha da IQ Option" android:inputType="textPassword" />
        <Button android:id="@+id/buttonConnectIq" style="@style/PrimaryButton" android:text="Conectar IQ Option" />
        <TextView android:id="@+id/iqStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="IQ Option desconectada" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="4dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Modo de operação: DEMO (proteção inicial). A senha da corretora não fica salva no aplicativo." android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="6dp" />

        <TextView style="@style/Label" android:text="ATIVO E PERÍODO" />
        <Spinner android:id="@+id/assetSpinner" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/bg_input" android:paddingStart="10dp" android:paddingEnd="10dp" />
        <RadioGroup android:id="@+id/timeframeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <RadioButton android:id="@+id/tfM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M1" android:textColor="@color/text" />
            <RadioButton android:id="@+id/tfM5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M5" android:textColor="@color/text" />
            <RadioButton android:id="@+id/tfM15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M15" android:textColor="@color/text" />
        </RadioGroup>

        <TextView style="@style/Label" android:text="GERENCIAMENTO DE RISCO (DEMO)" />
        <EditText android:id="@+id/stakeInput" style="@style/Field" android:hint="Valor de cada entrada (R$)" android:inputType="numberDecimal" android:text="2" />
        <EditText android:id="@+id/lossInput" style="@style/Field" android:hint="Limite máximo de perda (R$)" android:inputType="numberDecimal" android:text="10" />
        <EditText android:id="@+id/profitInput" style="@style/Field" android:hint="Meta de ganho (R$)" android:inputType="numberDecimal" android:text="20" />

        <TextView style="@style/Label" android:text="ESTRATÉGIAS DE ANÁLISE" />
        <CheckBox android:id="@+id/strategyEma" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tendência EMA 9 / 21" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/strategyRsi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Momentum RSI 14" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/strategySr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suporte e resistência" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/strategyCandle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Padrões de candles" android:textColor="@color/text" android:checked="true" />

        <TextView style="@style/Label" android:text="PADRÕES DE VELAS" />
        <CheckBox android:id="@+id/patternEngulf" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Engolfo de alta / baixa" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternMorning" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela da manhã" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternEvening" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela da noite" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternSoldiers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Três soldados brancos" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternCrows" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Três corvos negros" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternHammer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Martelo / martelo invertido" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternStar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela cadente / enforcado" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternHarami" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Harami de alta / baixa" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternPiercing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Linha de perfuração" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternCloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nuvem negra" android:textColor="@color/text" android:checked="true" />
        <CheckBox android:id="@+id/patternDoji" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Doji (somente confirmação)" android:textColor="@color/text" android:checked="true" />

        <Button android:id="@+id/buttonStart" style="@style/PrimaryButton" android:text="Iniciar bot" android:layout_marginTop="18dp" />
        <Button android:id="@+id/buttonStop" style="@style/GhostButton" android:text="Parar bot" />
        <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_card" android:padding="14dp" android:text="Entre no LS Broker e conecte sua IQ Option para começar." android:textColor="@color/text" android:textSize="13sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="O painel flutuante aparece ao iniciar o robô. A execução automática começa em DEMO; confira os limites e o saldo antes de iniciar. Operações financeiras envolvem risco." android:textColor="@color/muted" android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
