<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginBottom="8dp">
   <ImageView android:layout_width="58dp" android:layout_height="58dp" android:src="@drawable/ic_ai_trader_logo" android:contentDescription="Logo AI Trader Bridge" android:layout_marginEnd="12dp" />
   <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI TRADER BRIDGE" android:textColor="@color/text" android:textSize="22sp" android:textStyle="bold" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CANDLE INTELLIGENCE" android:textColor="@color/brand" android:textSize="10sp" android:letterSpacing="0.16" android:textStyle="bold" />
   </LinearLayout>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:layout_marginBottom="18dp" android:text="Leitura contínua do gráfico · confirmação no fechamento do candle" android:textColor="@color/muted" android:textSize="13sp" />
  <TextView style="@style/Label" android:text="PERÍODO DO GRÁFICO" />
  <RadioGroup android:id="@+id/timeframeGroup" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
   <RadioButton android:id="@+id/tfM1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M1" android:textColor="@color/text" />
   <RadioButton android:id="@+id/tfM5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M5" android:textColor="@color/text" />
   <RadioButton android:id="@+id/tfM15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="M15" android:textColor="@color/text" />
  </RadioGroup>
  <TextView style="@style/Label" android:layout_marginTop="14dp" android:text="ESTRATÉGIAS ATIVAS" />
  <CheckBox android:id="@+id/strategyEma" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tendência EMA 9 / 21" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyRsi" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Momentum RSI 14" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyMacd" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MACD" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyCandle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Padrões de candles / engolfo" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategySr" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Suporte e resistência" android:textColor="@color/text" />
  <TextView style="@style/Label" android:layout_marginTop="10dp" android:text="PADRÕES DE VELAS — SELECIONE INDIVIDUALMENTE" />
  <CheckBox android:id="@+id/strategyDoji" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Doji" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyHammer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Martelo / Martelo invertido" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyShootingStar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela cadente / Enforcado" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyMorningStar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela da manhã" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyEveningStar" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Estrela da noite" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyHarami" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Harami de alta / baixa" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyPiercing" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Linha de perfuração" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyDarkCloud" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nuvem negra" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyThreeSoldiers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Três soldados brancos" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyThreeCrows" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Três corvos negros" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyTweezers" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Topo / fundo pinça" android:textColor="@color/text" />
  <CheckBox android:id="@+id/strategyMarubozu" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Marubozu de alta / baixa" android:textColor="@color/text" />
  <TextView style="@style/Label" android:layout_marginTop="18dp" android:text="EXECUÇÃO AUTOMÁTICA INTEGRADA" />
  <CheckBox android:id="@+id/checkAutoTrade" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ativar execução automática (somente DEMO)" android:textColor="@color/text" />
  <Button android:id="@+id/buttonAccessibility" style="@style/GhostButton" android:text="Ativar acessibilidade do AITraderBridge" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Proteções: exige conta de prática visível, confiança mínima de 78%, intervalo de 60 segundos e máximo de 5 operações por sessão. O valor e a expiração são os que estiverem configurados na corretora." android:textColor="@color/muted" android:textSize="11sp" />
  <Button android:id="@+id/buttonOverlay" style="@style/GhostButton" android:layout_marginTop="14dp" android:text="Permitir painel flutuante" />
  <Button android:id="@+id/buttonCapture" style="@style/PrimaryButton" android:text="Iniciar análise" />
  <Button android:id="@+id/buttonCalibrate" style="@style/GhostButton" android:text="Calibração manual de segurança" />
  <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:background="@drawable/bg_card" android:padding="14dp" android:text="Pronto para analisar" android:textColor="@color/text" android:textSize="13sp" />
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Abra qualquer ativo na IQ Option e mantenha o gráfico visível. O app identifica candles pela imagem; não é necessário cadastrar o par. A calibração automática depende de a escala de preços estar visível e legível. Os sinais são informativos; confirme manualmente as operações." android:textColor="@color/muted" android:textSize="11sp" />
 </LinearLayout>
</ScrollView>
